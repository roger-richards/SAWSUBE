# ---- frontend build ----
FROM node:20-alpine AS frontend
WORKDIR /fe
COPY frontend/package.json ./
RUN npm ci --silent
COPY frontend/ .
RUN npm run build

# ---- python build stage ----
FROM python:3.11-slim AS build
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

# Install system build deps needed for cffi, Pillow, uvloop, cryptography, etc.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    python3-dev \
    libffi-dev \
    libssl-dev \
    pkg-config \
    libjpeg-dev \
    zlib1g-dev \
    git \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Copy only requirements first to leverage Docker layer cache
COPY backend/requirements.txt ./backend/requirements.txt

# Upgrade pip and install requirements with verbose output for CI logs
RUN python -m pip install --upgrade pip setuptools wheel \
 && python -m pip install --no-cache-dir -r backend/requirements.txt -v

# Copy source and build artifacts
COPY backend/ ./backend/
COPY --from=frontend /fe/dist ./frontend/dist

# (Optional) run tests or build steps here
# RUN pytest -q

# ---- final runtime image ----
FROM python:3.11-slim
WORKDIR /app

# Minimal runtime deps for Pillow and other libs
RUN apt-get update && apt-get install -y --no-install-recommends \
    libjpeg-dev \
    zlib1g-dev \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Copy installed Python packages and app files from build stage
COPY --from=build /usr/local/lib/python3.11 /usr/local/lib/python3.11
COPY --from=build /usr/local/bin /usr/local/bin
COPY --from=build /app ./app

WORKDIR /app
ENV PYTHONUNBUFFERED=1
ENV FRONTEND_DIST=/app/frontend/dist
EXPOSE 8000

# Use a non-root user for runtime
RUN addgroup --system app && adduser --system --ingroup app app
USER app

CMD ["python", "-m", "backend.main"]
