# ---- build stage ----
FROM python:3.11-slim AS build

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

# Install system build dependencies needed for cffi, Pillow, uvloop, etc.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    python3-dev \
    libffi-dev \
    libssl-dev \
    libjpeg-dev \
    zlib1g-dev \
    libblas-dev \
    liblapack-dev \
    pkg-config \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy only requirements first to leverage Docker layer cache
COPY backend/requirements.txt ./backend/requirements.txt

# Upgrade pip and install requirements (verbose for CI logs)
RUN python -m pip install --upgrade pip setuptools wheel \
 && python -m pip install --no-cache-dir -r backend/requirements.txt -v

# Copy rest of the source
COPY backend/ ./backend/
COPY frontend/dist ./frontend/dist

# (Optional) run tests or build steps here
