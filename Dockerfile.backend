# ---- frontend build (Debian-based to avoid Alpine build issues) ----
FROM node:20-bullseye-slim AS frontend
WORKDIR /fe

# Install minimal build deps for native modules (only when needed)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
  && rm -rf /var/lib/apt/lists/*

COPY frontend/package.json ./frontend/package.json
# Copy lockfile if present to enable npm ci
COPY frontend/package-lock.json ./frontend/package-lock.json

# Use npm ci when lockfile exists, otherwise fall back to npm install
RUN if [ -f ./frontend/package-lock.json ]; then \
      npm ci --no-audit --progress=false; \
    else \
      npm install --no-audit --progress=false; \
    fi

COPY frontend/ .
RUN npm run build

# ---- python build stage (unchanged, but ensure libffi-dev etc present) ----
FROM python:3.11-slim AS build
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc g++ python3-dev libffi-dev libssl-dev pkg-config \
    libjpeg-dev zlib1g-dev git ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./backend/requirements.txt
RUN python -m pip install --upgrade pip setuptools wheel \
 && python -m pip install --no-cache-dir -r backend/requirements.txt -v

COPY backend/ ./backend/
COPY --from=frontend /fe/dist ./frontend/dist

# ---- final runtime image ----
FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    libjpeg-dev zlib1g-dev ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /usr/local/lib/python3.11 /usr/local/lib/python3.11
COPY --from=build /usr/local/bin /usr/local/bin
COPY --from=build /app ./app

ENV PYTHONUNBUFFERED=1
ENV FRONTEND_DIST=/app/frontend/dist
EXPOSE 8000

RUN addgroup --system app && adduser --system --ingroup app app
USER app

CMD ["python", "-m", "backend.main"]
